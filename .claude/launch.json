{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fire",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose", "-f", "config/docker-compose.yml",
        "run", "--rm", "--service-ports",
        "-e", "FIRE_AUTH_DISABLED=true",
        "-e", "SESSION_SECRET=local-dev-session-secret-not-for-prod-0000",
        "fire"
      ],
      "port": 3001
    }
  ]
}
