# Environment Variables

# --- Application Configuration ---
# SITE_ID
# A unique identifier for this specific site or application instance.
# This could be a UUID or a descriptive string.
SITE_ID=your_unique_site_identifier

# SITE_NAME
# The human-readable name of the site or application.
SITE_NAME="Fire App"

# REPO_URL
# The full URL to the GitHub repository of this project.
REPO_URL=https://github.com/nitsuah/fire

# OWNER
# The GitHub username or organization name that owns the repository.
OWNER=nitsuah

# REPO
# The name of the repository.
REPO=fire

# --- Database Configuration ---
# DATABASE_URL
# Connection string for the database.
# Example for PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/fire_dev

# --- Authentication & Security ---
# SECRET_KEY
# A secret key used for things like session management, JWT signing, or hashing.
# IMPORTANT: Generate a strong, random string for production environments.
# Example: openssl rand -base64 32
SECRET_KEY=your_very_long_random_secret_key_here

# FIRE_API_KEY
# Optional. When set, all /api/* routes require an X-Api-Key header matching
# this value. Protects the Express API from unauthorized local access.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIRE_API_KEY=

# SYNC_MASTER_KEY
# Optional. When set, db.json is encrypted at rest using AES-256-GCM.
# Must be exactly 64 hex characters (32 bytes). If you lose this key, data
# is unrecoverable. Before enabling, export a JSON backup via the UI and
# store it alongside your key material (in a password manager, not plaintext
# next to the database). Delete any temporary plaintext db.json after migration.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_MASTER_KEY=

# SESSION_SECRET
# Used to sign express-session cookies. Must be a long random string.
# The server will warn at startup if this is unset or left as the default.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- eBay API Connector (PROD Phase 1) ---
# Register at https://developer.ebay.com — create an application for the Order API.
# Scope required: https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ENVIRONMENT=sandbox       # Change to "production" after testing

# --- Web3 / Crypto Wallet Tracking (PROD Phase 1) ---
# Register at each block explorer site to get a free API key.
# Wallets with no key for their chain will show a "key not configured" warning.
ETHERSCAN_API_KEY=             # https://etherscan.io (ETH + ERC-20)
BSCSCAN_API_KEY=               # https://bscscan.com (BNB Smart Chain)
POLYGONSCAN_API_KEY=           # https://polygonscan.com (Polygon)
ARBISCAN_API_KEY=              # https://arbiscan.io (Arbitrum One)
BASESCAN_API_KEY=              # https://basescan.org (Base)
ROUTESCAN_API_KEY=             # https://routescan.io (Avalanche, optional)
COINGECKO_API_KEY=             # https://coingecko.com/api — optional; increases rate limit

# --- Google Drive Encrypted Backup ---
# Setup: create OAuth 2.0 credentials in Google Cloud Console (Web application type),
# add http://localhost:2081/api/backup/drive/callback as an authorized redirect URI,
# then set GDRIVE_CLIENT_ID and GDRIVE_CLIENT_SECRET below.
# After the server starts, visit http://localhost:2081/api/backup/drive/authorize
# to complete one-time Google authorization. The refresh token is stored encrypted
# at data/tokens-gdrive.json (requires SYNC_MASTER_KEY).
GDRIVE_CLIENT_ID=              # OAuth 2.0 Client ID from Google Cloud Console
GDRIVE_CLIENT_SECRET=          # OAuth 2.0 Client Secret
GDRIVE_REDIRECT_URI=           # Optional override (default: http://localhost:2081/api/backup/drive/callback)
GDRIVE_BACKUP_FOLDER_ID=       # Optional: pin to a specific Drive folder ID (auto-created if blank)

# --- Vehicle Value API ---
# NHTSA VIN decode is always free (no key needed).
# For market value estimates, set VEHICLE_VALUE_PROVIDER=vinaudit (100 free req/month).
# Without a key, the built-in depreciation model is used automatically.
VEHICLE_VALUE_API_KEY=
VEHICLE_VALUE_PROVIDER=        # Optional: "vinaudit" for live market data

# --- Plaid / Fidelity Integration (PROD Phase 2) ---
# Register at https://plaid.com — supports Fidelity, bank accounts, and more.
# Start in sandbox; apply for production access separately.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox              # Change to "production" after testing

# --- Stock Price API Alternative (PROD Phase 2) ---
# Used as a stable alternative to Yahoo Finance's crumb-based scraping.
# Set one of the following; Yahoo Finance is used as fallback if neither is set.
ALPHA_VANTAGE_API_KEY=         # https://alphavantage.co (25 req/day free)
POLYGON_API_KEY=               # https://polygon.io (delayed free tier)

# --- Runtime Configuration ---
# NODE_ENV
#