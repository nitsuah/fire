# Environment Variables

# --- Application Configuration ---
# SITE_ID
# A unique identifier for this specific site or application instance.
# This could be a UUID or a descriptive string.
SITE_ID=your_unique_site_identifier

# SITE_NAME
# The human-readable name of the site or application.
SITE_NAME="Fire App"

# REPO_URL
# The full URL to the GitHub repository of this project.
REPO_URL=https://github.com/nitsuah/fire

# OWNER
# The GitHub username or organization name that owns the repository.
OWNER=nitsuah

# REPO
# The name of the repository.
REPO=fire

# --- Database Configuration ---
# DATABASE_URL
# Connection string for the database.
# Example for PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/fire_dev

# --- Authentication & Security ---
# SECRET_KEY
# A secret key used for things like session management, JWT signing, or hashing.
# IMPORTANT: Generate a strong, random string for production environments.
# Example: openssl rand -base64 32
SECRET_KEY=your_very_long_random_secret_key_here

# FIRE_API_KEY
# Optional. When set, all /api/* routes require an X-Api-Key header matching
# this value. Protects the Express API from unauthorized local access.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIRE_API_KEY=

# SYNC_MASTER_KEY
# Optional. When set, db.json is encrypted at rest using AES-256-GCM.
# Must be exactly 64 hex characters (32 bytes). If you lose this key, data
# is unrecoverable — keep a plaintext backup before enabling.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_MASTER_KEY=

# SESSION_SECRET
# Used to sign express-session cookies. Should be a long random string.
SESSION_SECRET=change_me_in_production

# --- External APIs ---
# API_KEY
# A generic placeholder for any external API key required by the application.
API_KEY=your_external_api_key_here

# --- Runtime Configuration ---
# NODE_ENV
#